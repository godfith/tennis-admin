export function defaultPermsForRole(role) {
  const pages = (ALLOWED[role] || []).filter((k) => k !== '*')
  const actions = ROLE_DEFAULT_ACTIONS[role] || []
  return pages.concat(actions)
}

export function getPerms() {
  try {
    const raw = JSON.parse(localStorage.getItem('admin_perms') || '[]')
    return Array.isArray(raw) ? raw.filter((k) => k && !String(k).startsWith('venue:')) : []
  } catch (e) {
    return []
  }
}

export function allowedVenueIds() {
  try {
    const raw = JSON.parse(localStorage.getItem('admin_venue_ids') || '[]')
    if (Array.isArray(raw) && raw.length) return raw.map(String)
  } catch (e) {}
  const one = localStorage.getItem('admin_venue_id') || ''
  return one ? [one] : []
}

export function canSwitchVenue() {
  if (roleKind() === 'admin') return true
  return allowedVenueIds().length > 1
}

export function canAccess(path) {
  if (roleKind() === 'admin') return true
  const custom = getPerms()
  if (custom.length) return custom.includes(path)
  const list = ALLOWED[roleKind()] || []
  return list.includes(path)
}

export function can(action) {
  if (roleKind() === 'admin') return true
  const custom = getPerms()
  if (custom.length) {
    if (action === 'issueCard' && (custom.includes('issueCard') || custom.includes('/users'))) return true
    if (action === 'gift' && (custom.includes('gift') || custom.includes('/gift'))) return true
    if (action === 'finance' && (custom.includes('finance') || custom.includes('/finance'))) return true
    if (action === 'switchVenue') return custom.includes('switchVenue') || allowedVenueIds().length > 1
    return custom.includes(action)
  }
  const k = roleKind()
  const map = {
    switchVenue: k === 'admin',
    finance: k === 'admin' || k === 'manager',
    refundCard: k === 'admin' || k === 'manager',
    extendCard: k === 'admin' || k === 'manager',
    issueCard: k === 'admin' || k === 'manager' || k === 'front',
    book: k === 'admin' || k === 'manager' || k === 'front',
    cancelBook: k === 'admin' || k === 'manager' || k === 'front',
    enrollGroup: k === 'admin' || k === 'manager' || k === 'front',
    editGroup: k === 'admin' || k === 'manager',
    editCourt: k === 'admin' || k === 'manager',
    editPrice: k === 'admin' || k === 'manager',
    editCoach: k === 'admin' || k === 'manager',
    editStaff: k === 'admin',
    editTemplate: k === 'admin'
  }
  return !!map[action]
}

export function homePath() {
  const custom = getPerms()
  if (custom.length) {
    const pages = ['/dashboard', '/activity', '/finance', '/occupancy', '/bookings', '/users', '/cards']
    for (const p of pages) if (custom.includes(p)) return p
    return custom[0].startsWith('/') ? custom[0] : '/dashboard'
  }
  return HOME[roleKind()] || '/bookings'
}
